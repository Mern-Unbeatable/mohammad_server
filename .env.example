# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Frontend origin for Stripe Checkout return URLs
CLIENT_URL=http://localhost:5173
# Public web app URL used in emailed links such as password reset
# (falls back to CLIENT_URL when empty)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lab_unity?schema=public"

# ------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
# Lifetime of emailed password reset links
PASSWORD_RESET_TTL_MINUTES=30
# Minimum seconds between reset emails for the same account
PASSWORD_RESET_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------
# Email (SMTP) — used for password reset links.
# Put real credentials only in .env (git-ignored), never in source.
# SMTP_SECURE: true for port 465 (implicit TLS); false for 587 (STARTTLS).
# Defaults to true when SMTP_PORT=465.
# If SMTP_HOST is empty, emails are skipped in development (only the
# recipient and subject are logged) and fail in production.
# Legacy names SMTP_PASS and MAIL_FROM are still accepted.
# ------------------------------------------------------------------
SMTP_HOST=no-reply@labunity.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Lab Unity <no-reply@labunity.com>"

# ------------------------------------------------------------------
# File uploads
# ------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
# Most files accepted in one upload request
MAX_UPLOAD_FILES=12
# Chat attachments live here and are only served through signed links.
# Must be on persistent storage, and must not be inside UPLOAD_DIR.
PRIVATE_UPLOAD_DIR=private-uploads
# HMAC key for chat attachment links (defaults to a key derived from JWT_ACCESS_SECRET)
ATTACHMENT_URL_SECRET=
# Signed link lifetime step; a link stays valid for between one and two steps
ATTACHMENT_URL_TTL_SECONDS=21600
# Public base URL used to build absolute file URLs
PUBLIC_URL=http://localhost:4000

# ------------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ------------------------------------------------------------------
# Seed admin account (used by prisma/seed.ts)
# ------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin.lab@gmail.com
SEED_ADMIN_PASSWORD=Demo123!

# ------------------------------------------------------------------
# Stripe payments (required for paid subscriptions)
# Create Products/Prices in Stripe Dashboard, then paste IDs below.
# Full setup: docs/integrations/stripe-setup.md
# Webhook endpoint: POST {PUBLIC_URL}{API_PREFIX}/subscriptions/webhook
# CLIENT_URL is used for Checkout success/cancel redirects.
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
